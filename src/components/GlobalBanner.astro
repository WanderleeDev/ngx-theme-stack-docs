---
/**
 * Custom Global Banner component for Starlight.
 * This component overrides the default Banner to provide a site-wide call to action
 * while still respecting per-page banners if defined and supporting i18n.
 */
const { banner } = Astro.locals.starlightRoute.entry.data;
const { lang } = Astro.locals.starlightRoute;

// Define localized fallback messages
const messages = {
  es: '⭐ ¿Te gusta ngx-theme-stack? ¡Apóyanos con una estrella en <a href="https://github.com/WanderleeDev/ngx-theme-stack">GitHub</a>!',
  en: '⭐ Loving ngx-theme-stack? Support us with a star on <a href="https://github.com/WanderleeDev/ngx-theme-stack">GitHub</a>!'
};

// Select message based on current language (defaults to English)
const globalContent = messages[lang as keyof typeof messages] || messages.en;

const effectiveBanner = banner || { content: globalContent };
---

<div class="sl-banner" data-pagefind-ignore set:html={effectiveBanner.content} />

<style>
	.sl-banner {
		--__sl-banner-text: var(--sl-color-banner-text, var(--sl-color-text-invert));
		padding: 0.5rem 1rem;
		background-color: var(--sl-color-banner-bg, var(--sl-color-bg-accent));
		color: var(--__sl-banner-text);
		font-weight: 600;
		text-align: center;
		font-size: var(--sl-text-sm);
		line-height: var(--sl-line-height-tight);
    border-bottom: 1px solid var(--sl-color-hairline-shade);
	}
	.sl-banner :global(a) {
		color: var(--__sl-banner-text);
		text-decoration: underline;
    font-weight: 700;
	}
  .sl-banner :global(a:hover) {
    opacity: 0.8;
  }
</style>
